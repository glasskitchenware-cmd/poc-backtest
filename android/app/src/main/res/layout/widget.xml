<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: the last check's signals (from Alerts.onScan), its status and the next 4-hour close. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="POC Signal · Trend 4H"
            android:textColor="#FFF0B90B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#FF0ECB81"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_lines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:maxLines="4"
        android:text="ยังไม่มีผลเช็ก · เปิดแอปครั้งแรกเพื่อเริ่ม"
        android:textColor="#FFEAECEF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/w_foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FF848E9C"
        android:textSize="11sp" />
</LinearLayout>
